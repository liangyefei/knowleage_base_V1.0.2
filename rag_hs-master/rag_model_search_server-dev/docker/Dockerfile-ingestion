# 知识库入库镜像（写路径）
# - 完全沿用原版 Dockerfile 环境（requirements.txt + unstructured + tree-sitter + libreoffice 全家桶），
#   仅改 ENTRYPOINT → startup_ingestion.py + 末尾加 ENV HAISI_RUN_MODE=ingest
# - HAISI_RUN_MODE=ingest：startup.py 启动 KafkaCommServer，api.py 仅挂载入库 + 摘要路由
# - 对应 K8s：ingestion Deployment（分钟级任务、CPU 密集、Kafka 驱动、低副本数）
#FROM taylor_cuda11.8.0_torch2.0.1_fastapi-devel:latest
# 镜像里面是Python 3.10.6  | torch==2.0.1
# 注意这个基础镜像没有底层Dockerfile文件，只能使用备份的docker镜像本地文件ragchat.tar。
# FROM haisi_rag_server:latest
# FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04
FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/ghcr.io/astral-sh/uv:python3.10-bookworm-slim

LABEL version="1.0" date="2026-07-30 14:04"
LABEL baseimages="uv:python3.10-bookworm-slim"
LABEL maintainer="taylor.he@ferban.com"

# 更新系统软件
RUN export DEBIAN_FRONTEND=noninteractive \
    && sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' \
        /etc/apt/sources.list.d/debian.sources 2>/dev/null || true \
    && sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' \
        /etc/apt/sources.list 2>/dev/null || true \
    && apt-get -y update --fix-missing \
    && apt-get install -y -f --fix-missing tzdata net-tools openssh-server build-essential vim software-properties-common curl locales zstd tmux git \
    && apt-get autoremove -y --force-yes \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i 's/^# *zh_CN.UTF-8/zh_CN.UTF-8/' /etc/locale.gen \
    && locale-gen zh_CN.UTF-8 \
    && ln -fs /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && dpkg-reconfigure --frontend noninteractive tzdata \
    && echo "export LANG='zh_CN.UTF-8'" >> /etc/profile \
    && echo "export LC_ALL='zh_CN.UTF-8'" >> ~/.bashrc

# ==================================================================
# 解决加载文档时出错：libGL.so.1: cannot open shared object file
RUN apt update && apt install libgl1-mesa-glx libreoffice libpng-dev default-jdk ghostscript libmagic-dev -y

# 配置 uv 阿里云 PyPI 镜像（基础镜像自带 uv 与 pip，无需 get-pip.py）
ENV UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    UV_HTTP_TIMEOUT=120


COPY docker/requirements.txt /workspace/requirements.txt

RUN chmod +x /workspace/requirements.txt
RUN uv pip install --system --no-cache -r /workspace/requirements.txt

#RUN uv pip install --no-cache unstructured==0.12.0 unstructured_inference==0.6.1 huggingface_hub==0.25.0 'onnxruntime<1.20' pikepdf -i https://pypi.tuna.tsinghua.edu.cn/simple
RUN uv pip install --system  unstructured==0.12.0 unstructured_inference==0.6.1 huggingface_hub==0.25.0 'onnxruntime<1.20' pikepdf -i https://pypi.tuna.tsinghua.edu.cn/simple
RUN uv pip install --system onnx==1.17.0 ml_dtypes -i https://pypi.tuna.tsinghua.edu.cn/simple
RUN uv pip install --system 'numpy>=1.21.6,<1.28.0' -i https://pypi.tuna.tsinghua.edu.cn/simple
RUN uv pip install --system setuptools==69.5.1 -i https://pypi.tuna.tsinghua.edu.cn/simple

RUN uv pip install --system xlrd==2.0.1 -i https://pypi.tuna.tsinghua.edu.cn/simple
RUN uv pip install --system tree-sitter==0.20.4 tree-sitter-languages==1.8.0 -i https://pypi.tuna.tsinghua.edu.cn/simple
RUN uv pip install --system uvloop -i https://pypi.tuna.tsinghua.edu.cn/simple
RUN uv pip install --system tree-sitter-language-pack==1.15.8 -i https://pypi.tuna.tsinghua.edu.cn/simple
RUN uv pip install --system  kafka-python==3.0.11 -i https://pypi.tuna.tsinghua.edu.cn/simple

COPY docker/parsers.json /root/.cache/tree-sitter-language-pack/v1.15.8/manifest.json
COPY docker/parsers-linux-x86_64.tar.zst /tmp/parsers-linux-x86_64.tar.zst
RUN mkdir -p /root/.cache/tree-sitter-language-pack/v1.15.8/libs \
    && tar --zstd -x -C /root/.cache/tree-sitter-language-pack/v1.15.8/libs -f /tmp/parsers-linux-x86_64.tar.zst \
    && chown -R root:root /root/.cache/tree-sitter-language-pack \
    && rm /tmp/parsers-linux-x86_64.tar.zst
# ----------------------unstructured包依赖问题-------------------------------------
# 先创建目录
RUN mkdir -p /root/nltk_data/taggers /root/nltk_data/tokenizers
# 复制压缩包进镜像
COPY assets/nltk_data/tokenizers /root/nltk_data/tokenizers
COPY assets/nltk_data/taggers /root/nltk_data/taggers
# -------------------------------------------------------------------------------

# RUN pip3 install --no-cache-dir psycopg2-binary streamlit-option-menu==0.1.2 

# ocr实现GPU加速
# RUN pip3 install --no-cache-dir rapidocr_paddle[gpu]>=1.3.0.post5 -i https://pypi.tuna.tsinghua.edu.cn/simple

# ==================================================================
# 配置 sshd（openssh-server 已在上一步 apt install 安装）
# 生产容器：sshd 不作为主进程，仅供调试；主进程为 startup.py
# 开发容器（Dockerfile-dev）：sshd 作为主进程（CMD ["sshd","-D"]）
RUN mkdir -p /var/run/sshd \
    && sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config \
    && sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    && echo 'root:123456' | chpasswd

# EXPOSE 仅声明 ENTRYPOINT 自动启起的端口：
# - 7861 API（startup_ingestion.py → sys.argv=--api，仅起 API，不起 WebUI）
# 22（sshd）未自动启动，仅供调试；8501 无 WebUI；12345 旧版端口 startup 不使用
EXPOSE 7861

# ==================================================================
RUN echo "export TF_ENABLE_ONEDNN_OPTS=0" >> /etc/profile
#RUN echo "export OPENAI_API_KEY=123456789" >> /etc/profile
#RUN echo "export TOKENIZERS_PARALLELISM=false" >> /etc/profile

#ENV OPENAI_API_KEY 123456789
#ENV TOKENIZERS_PARALLELISM false

COPY . /workspace/haisi_rag_models_server

RUN chmod +x /workspace/haisi_rag_models_server

WORKDIR /workspace/haisi_rag_models_server/

# 运行模式：ingest = 仅入库路由 + Kafka 消费者
ENV HAISI_RUN_MODE=ingest

# startup_ingestion.py：thin wrapper（env=ingest + argv=--api），复用 startup.py 的 start_main_server，
# 起 ingest 路由 API + KafkaCommServer，不起 WebUI（WebUI 并入 QA）
ENTRYPOINT ["python3", "startup_ingestion.py"]
