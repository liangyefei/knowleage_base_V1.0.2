@startuml
top to bottom direction

skinparam linetype ortho
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontColor black
skinparam ranksep 70
skinparam nodesep 50

skinparam package {
    BackgroundColor white
    BorderColor black
    FontColor black
}
skinparam node {
    BackgroundColor white
    BorderColor black
    FontColor black
}
skinparam ArrowColor black
skinparam ArrowFontColor black

' ===== 终端区 =====
package "终端区" as TERM {
  node "用户浏览器" as U
  node "Coding Agent\n(Claude/Hermes/Cursor/Trae)" as AG
}

' ===== DMZ 区（接入边界）=====
package "DMZ 区（接入边界）" as DMZ {
  node "WAF\nWeb应用防火墙\nOWASP/SQL注入/XSS/CC" as WAF
  node "APIG\n鉴权·限流·幂等·防重放·路由" as APIG
  node "堡垒机 CBG\n运维唯一入口·录屏审计" as CBG
}

' ===== 应用区（CCE Autopilot · 私有子网 · mTLS）=====
package "应用区（CCE Autopilot · mTLS）" as APP {
  node "前端页面\nWeb UI / 微前端\n问答/溯源/可视化/后台" as FE
  node "后端服务\n检索编排/鉴权/版本/知识管理" as BE
  node "MCP 服务\nAgent 适配 / MCP 工具集" as MCP
  node "消息队列\nKafka · 幂等 · 重试 · 背压" as Q
  package "模型服务（入库/检索子池分离）" as PROC {
    node "入库子池\n解析/切片/Embedding/图谱抽取\n(CPU 节点池·批处理)" as IL
    node "检索子池\n三路召回/Reranker/LLM生成\n(GPU 节点池·低延迟)" as RL
  }
}

' ===== 数据区（私有子网 · 存储加密 · KMS）=====
package "数据区（存储加密 · KMS）" as DATA {
  node "CSS\n向量语义 + BM25 全文" as CSS
  node "GES\n知识图谱 · 三角关联" as GES
  node "RDS PostgreSQL\n元数据/权限/RLS 行级安全" as RDS
  node "SFS\n原始文件 · 加密" as SFS
  node "DCS\n热点缓存 · 会话 · 限流" as DCS
}

' ===== 管理区（独立子网 · 仅堡垒机可达）=====
package "管理区（仅堡垒机可达）" as MGMT {
  node "Prometheus / Grafana\n指标采集 · 告警" as MON
  node "LTS 日志 + 审计哈希链\n保留 ≥ 180 天" as LOG
}

' ----- 终端 -> DMZ -----
U --> WAF : TLS 1.3
AG --> WAF : TLS 1.3 · MCP/REST

' ----- DMZ 内部 -----
WAF --> APIG

' ----- DMZ -> 应用区 -----
APIG --> FE : HTTPS
APIG --> BE : REST
APIG --> MCP : MCP

' ----- 应用区内部 -----
FE --> BE : HTTPS/REST
MCP --> BE : REST/RPC 透传身份
BE --> RL : 同步：检索调度
BE -.-> Q : 异步：入库任务
Q -.-> IL : 任务消费

' ----- 应用区 -> 数据区 -----
RL --> CSS : 向量/关键词召回
RL --> GES : 实体/关系遍历
RL --> DCS : 缓存写入
IL --> CSS : 写入向量/倒排
IL --> GES : 写入实体关系
IL --> RDS : 写入元数据
IL --> SFS : 关联原始文件
BE --> RDS : 读写元数据/权限
BE --> DCS : 缓存读写
BE -.-> SFS : 溯源：读原件

' ----- 运维通道 -----
CBG -.-> BE : SSH 运维

' ----- 管理区（日志/指标采集）-----
BE -.-> LOG : 日志/审计
RL -.-> MON : 指标采集

@enduml
