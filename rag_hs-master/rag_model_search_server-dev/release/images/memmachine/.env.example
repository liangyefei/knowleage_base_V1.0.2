# ==================== MemMachine 服务配置 ====================
# 复制本文件为 .env 并按需修改：
#   cp .env.example .env
#
# docker-compose.yml 通过 ${VAR:-default} 语法读取这些变量；
# 未设置时使用 docker-compose.yml 中的默认值。
# 参考：MemMachine.md §12 环境变量与默认值

# ── 镜像构建参数 ──────────────────────────────────────────────────────
# 是否构建 GPU 版本（true 含 sentence-transformers 本地 embedding GPU 依赖）
# CPU 部署保持 false；GPU 部署设 true 并在 docker-compose.yml 中配置 GPU 资源
GPU=false

# 镜像 tag 后缀（配合 docker-compose.yml 中 image: haisi-memmachine:${IMAGE_TAG:-cpu}）
IMAGE_TAG=cpu

# SCM 版本号（传入 Dockerfile 的 SETUPTOOLS_SCM_PRETEND_VERSION）
# 用于 setuptools-scm 生成版本号；本地构建保持 0.0.0 即可
SCM_VERSION=0.0.0

# ── 端口映射（宿主机:容器）──────────────────────────────────────────
# MemMachine REST API v2 + MCP 端口
MEMORY_SERVER_PORT=8080

# PostgreSQL 端口
POSTGRES_PORT=5432

# Neo4j 端口（HTTP / HTTPS / Bolt）
NEO4J_HTTP_PORT=7474
NEO4J_HTTPS_PORT=7473
NEO4J_PORT=7687

# ── PostgreSQL 凭证 ───────────────────────────────────────────────────
# 注意：修改后需同步更新 configuration.yml 中 resources.databases.profile_storage.config
POSTGRES_HOST=postgres
POSTGRES_DB=memmachine
POSTGRES_USER=memmachine
POSTGRES_PASSWORD=memmachine_password

# ── Neo4j 凭证 ────────────────────────────────────────────────────────
# 注意：修改后需同步更新 configuration.yml（若使用 declarative 后端）
NEO4J_HOST=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# ── MemMachine 应用配置 ───────────────────────────────────────────────
# 配置文件路径（docker-compose.yml 已挂载 ./configuration.yml 到此路径）
MEMORY_CONFIG=/app/configuration.yml

# MCP 内部回调地址（容器间通信）
MCP_BASE_URL=http://memmachine:8080

# 对外网关地址（客户端访问入口）
GATEWAY_URL=http://localhost:8080

# FastAPI/MCP 日志级别：INFO | DEBUG | WARNING | ERROR
FAST_MCP_LOG_LEVEL=INFO

# 应用日志级别：INFO | DEBUG | WARNING | ERROR
LOG_LEVEL=INFO

# uvicorn worker 数；CPU 密集型（本地 embedding）建议 1-2，API 密集型建议 2-4
MEMMACHINE_WORKERS=1

# 是否启用配置管理 API（空=禁用；非空=启用，见 memmachine-server --with-config-api）
MEMMACHINE_CONFIG_API=

# ── LLM / Embedding API Key ──────────────────────────────────────────
# 本部署使用阿里云 DashScope + 智谱 GLM（OpenAI 兼容 endpoint）。
# configuration.yml 中以 $GLM_API_KEY / $ALIYUN_API_KEY 语法引用这两个变量
# （见 mixin_confs.py 的 WithValueFromEnv._resolve_env）。
# 请替换为实际的有效 key；以下为示例值，未开通额度时调用会返回 401/403。

# 智谱 GLM API Key（https://open.bigmodel.cn/usercenter/apikeys）
GLM_API_KEY=ea33715d506340e5a3126eb78aa7693b.i1Yq5gcXJOLKSF1E

# 阿里云 DashScope API Key（https://dashscope.console.aliyun.com/apiKey）
ALIYUN_API_KEY=sk-7a9a603a239144999b4f21f2459dc651

# 如改用 OpenAI 原生服务，在此设置 OPENAI_API_KEY 并更新 configuration.yml
OPENAI_API_KEY=
