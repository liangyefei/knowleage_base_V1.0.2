# OneAccess OIDC 对接环境变量示例
# 用法：复制为 .env（已被根 .gitignore 忽略，严禁提交真实密钥），
# 本地启动前 export 或由 IDE 注入；生产环境经 CCE Secret 注入，
# 参见 docs/deploy/oneaccess-oidc-cce-secret.md。

# OneAccess OIDC 开关：本地/测试默认 false（无租户也能启动）；CCE 上必须显式 true
OIDC_TENANT_ENABLED=true

# OneAccess 认证地址：填实例域名根，不带 /portal、不带 /api/v1/... 路径 —— quarkus.oidc.auth-server-url
# 例：https://<oneaccess实例域名>
# 校验方法：curl https://<域名>/.well-known/openid-configuration 能返回 JSON 即正确
OIDC_AUTH_SERVER_URL=

# OneAccess 门户中自建应用的 ClientId —— quarkus.oidc.client-id
OIDC_CLIENT_ID=

# OneAccess 门户中自建应用的 ClientSecret（敏感）—— quarkus.oidc.credentials.secret
OIDC_CLIENT_SECRET=

# userinfo 端点（刷新令牌时复核外部账号是否仍有效）—— oidc.provider.huawei.userinfo-uri
# 官方接口：GET https://{domain_name}/api/v1/oauth2/userinfo
# 例：https://<oneaccess实例域名>/api/v1/oauth2/userinfo
# 留空则该复核 fail-closed：外部账号用户刷新会被拒（需重新走一次 OneAccess 登录）
HUAWEI_USERINFO_URI=

# 登录成功后回前端的地址（携带一次性 code，前端再调 /oidc/token 换平台令牌）
# —— platform.oauth.frontend-callback-uri。生产必填，否则跳到 localhost:5173。
OAUTH_FRONTEND_CALLBACK_URI=

# 登出后回前端的地址（通常填登录页）—— oidc.logout-redirect-uri。
# 生产必填；同时 OneAccess 门户侧的「Logout URL」建议登记同一个前端登录页，
# 这样用户从门户注销也会回到我们的登录页（两条注销路径体验一致）。
OIDC_LOGOUT_REDIRECT_URI=